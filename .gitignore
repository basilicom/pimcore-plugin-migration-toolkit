# PhpStorm
.idea

# Composer (the bundle is the root package of the test rig)
/vendor/
/composer.lock

# Tool caches
/.phpunit.cache/
/.phpstan.cache/
/.php-cs-fixer.cache

# Test app runtime state — the install marker is committed on purpose
/tests/App/var/*
!/tests/App/var/config/
/tests/App/var/config/*
!/tests/App/var/config/needs-install.lock
/tests/App/public/*
!/tests/App/public/.gitkeep

# Generated by Pimcore at runtime
/tests/App/config/reference.php

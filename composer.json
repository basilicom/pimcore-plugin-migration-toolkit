{
    "name": "basilicom/pimcore-plugin-migration-toolkit",
    "description": "Set of Migration Helpers and further Migration Tools for Pimcore Migrations.",
    "type": "pimcore-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Kerstin Gerull",
            "email": "kerstin.gerull@basilicom.de",
            "homepage": "https://www.basilicom.de",
            "role": "Developer"
        },
        {
            "name": "Alexander Heidrich",
            "email": "alexander.heidrich@basilicom.de",
            "homepage": "https://www.basilicom.de",
            "role": "Developer"
        },
        {
            "name": "Fabian Fischer",
            "email": "fabian.fischer@basilicom.de",
            "homepage": "https://www.basilicom.de",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Basilicom\\PimcorePluginMigrationToolkit\\": "src/"
        }
    },
    "require": {
        "php": ">=8.3",
        "pimcore/pimcore": "^12.0",
        "symfony/translation": "^6.4 || ^7.3",
        "symfony/yaml": "^6.4 || ^7.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Basilicom\\PimcorePluginMigrationToolkit\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": [
            "php-cs-fixer fix --dry-run --diff",
            "phpstan analyse"
        ]
    }
}
